* Contracts a cap-dot-cup into a single bubblewithdot generator.

#procedure freezeBubbles();

  id bubble(m1?)=delta*idem;

	id cap(m1?,m2?)*blobdot?dots(m1?) * cup(m1?,m2?)= bubblewithdot(m1);

	id cap(m1?,m2?)*blobdot1?dots(m1?)*blobdot2?dots(m1?) * cup(m1?,m2?)= bubblewithtwodots(m1);

  id cap(m1?,m2?)*blobdot1?dots(m1?)*blobdot2?dots(m1?)*blobdot3?dots(m1?) * cup(m1?,m2?)= bubblewiththreedots(m1);

  id cap(m1?,m2?)*blobdot1?dots(m1?)*blobdot2?dots(m1?)*blobdot3?dots(m1?)*blobdot4?dots(m1?) * cup(m1?,m2?)= bubblewithfourdots(m1);

  id cap(m1?,m2?)*blobdot1?dots(m1?)*blobdot2?dots(m1?)*blobdot3?dots(m1?)*blobdot4?dots(m1?)*blobdot5?dots(m1?) * cup(m1?,m2?)= bubblewithfivedots(m1);

#endprocedure
